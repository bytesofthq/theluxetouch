# ==============================================================================
# The Luxe Touch - Environment Configuration Template
# Copy this file to .env.local and fill in your values
# ==============================================================================

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (MongoDB Atlas)
# Replace with your MongoDB connection string pointing to the "theluxetouch" database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/theluxetouch?retryWrites=true&w=majority

# Authentication (Better Auth)
# Generate a secret key with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_random_32_bytes_secret_key
BETTER_AUTH_URL=http://localhost:3000

# Media & Image Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional Transactional Email (Resend)
# Leave empty or omitted to disable transactional emails gracefully
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=concierge@theluxetouch.com
ADMIN_NOTIFICATION_EMAIL=admin@theluxetouch.com
